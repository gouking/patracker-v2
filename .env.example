# 複製成 .env.local 後填。這些值不要進版控。

# 必須跟 Trackly 完全相同,才能驗 Trackly 發的登入 cookie
SESSION_SECRET=
# Trackly 的 SQLite 檔(同一台機器,唯讀使用;登入驗證與使用者姓名都從這裡來)
TRACKLY_DB=
# Trackly 的網址(沒登入時導去那裡登入)。內網用 IP 連就寫 http://新主機IP:3000
TRACKLY_URL=http://192.168.x.x:3000
# 本站網址:信裡的連結只用它。內網用 IP 連就寫 http://新主機IP:3200
NEXT_PUBLIC_APP_URL=http://192.168.x.x:3200
# PA 資料庫(相對於 data/ 或絕對路徑)
DB_PATH=patracker.db

# 寄信(每日逾期信、即時通知、催供應商信)。沒設 → 一律不寄,不會報錯
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 排程:切換當天才設 1(之前 Vercel 還在寄)。台北時間幾點起寄
PA_SCHEDULER=
DIGEST_HOUR=8
SUPPLIER_CHASE_HOUR=9
REMINDER_TIMEZONE=Asia/Taipei
