# 複製成 .env.local 後填。這些值不要進版控。

# 簽登入 cookie 用的隨機密鑰(至少 32 字元)。產生:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 換掉它 = 所有人都要重新登入
SESSION_SECRET=
# 本站網址:信裡的連結(設定密碼、每日信)只用它。新主機:http://tpp1131.contoso.com(80 埠,網址不用寫埠號)
NEXT_PUBLIC_APP_URL=http://tpp1131.contoso.com
# PA 資料庫(相對於 data/ 或絕對路徑)。帳號也在同一個檔案裡
DB_PATH=patracker.db
# 每日備份(npm run backup):放哪、保留幾份。預設是專案旁邊的 patracker-backups、30 份
PA_BACKUP_DIR=
PA_BACKUP_KEEP=30

# 寄信(設定/重設密碼、每日逾期信、即時通知、催供應商信)。沒設 → 一律不寄,不會報錯
# 同事第一次登入要靠「忘記密碼」收信,所以上線前一定要先測通
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 排程:切換當天才設 1(之前 Vercel 還在寄)。台北時間幾點起寄
PA_SCHEDULER=
DIGEST_HOUR=8
SUPPLIER_CHASE_HOUR=9
REMINDER_TIMEZONE=Asia/Taipei
